{
  "name": "Paison",
  "scopeName": "source.paison",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#booleans" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.paison",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.paison",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.paison",
          "begin": "'",
          "end": "'|$",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.double.paison",
          "begin": "“",
          "end": "”|$",
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.paison",
          "begin": "‘",
          "end": "’|$",
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.paison",
      "match": "\\\\."
    },
    "keywords": {
      "name": "keyword.control.paison",
      "match": "(?<![\\p{L}\\p{N}_])(?:かんすう|かえす|もし|それとも|ちがうなら|くりかえす|のあいだ|こころみる|しっぱいしたとき)(?![\\p{L}\\p{N}_])"
    },
    "builtins": {
      "name": "support.function.builtin.paison",
      "match": "(?<![\\p{L}\\p{N}_])(?:しゅつりょく|にゅうりょく|かず|もじ|ながさ|はいれつ)(?![\\p{L}\\p{N}_])"
    },
    "booleans": {
      "name": "constant.language.boolean.paison",
      "match": "(?<![\\p{L}\\p{N}_])(?:しん|ぎ)(?![\\p{L}\\p{N}_])"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.paison",
          "match": "(?<![\\p{L}\\p{N}_])(?:かつ|または|ついか)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.paison",
          "match": "[=+*/%<>!&|^~＝＋－＊／％＜＞！＆｜＾～−-]+"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.paison",
      "match": "(?<![\\p{L}\\p{N}_])(?:[0-9０-９]+(?:[.．][0-9０-９]+)?|[.．][0-9０-９]+)(?:[eE][+-]?[0-9０-９]+)?(?![\\p{L}\\p{N}_])"
    }
  }
}
